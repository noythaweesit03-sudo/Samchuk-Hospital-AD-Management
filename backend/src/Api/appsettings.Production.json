{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "__PLACEHOLDER_PRODUCTION_ALLOWED_HOSTS__",
  "Security": {
    "RequireHttps": true,
    "EnforceMfa": true
  },
  "ActiveDirectory": {
    "DomainControllerHost": "__PLACEHOLDER_PRODUCTION_DC_HOST__",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=PLACEHOLDER_ORG_UNIT,DC=placeholder,DC=example",
    "IsLiveConnectionEnabled": false,
    "ConnectionTimeoutSeconds": 10
  },
  "AuditLogging": {
    "StorageProvider": "SqlServer",
    "ConnectionStringName": "AuditDatabaseConnection",
    "RetentionDays": 3650
  }
}
