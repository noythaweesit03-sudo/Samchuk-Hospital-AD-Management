{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "__PLACEHOLDER_PRODUCTION_ALLOWED_HOSTS__",
  "Security": {
    "RequireHttps": true,
    "EnforceMfa": true
  },
  "ActiveDirectory": {
    "DomainControllerFqdn": "__PLACEHOLDER_PRODUCTION_DC_FQDN__",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=PLACEHOLDER_ORG_UNIT,DC=placeholder,DC=example",
    "ReadOnlyServiceAccount": "__PLACEHOLDER_READONLY_SERVICE_ACCOUNT__",
    "ReadOnlyServicePassword": "__PLACEHOLDER_SECRET_DO_NOT_LOG__",
    "ConnectionTimeoutSeconds": 10,
    "LdapPageSize": 100,
    "EnableLiveReadOnlyConnection": false,
    "CertificateValidation": {
      "RequireValidCertificateChain": true,
      "RequireHostnameMatch": true,
      "AllowWildcardCertificates": false,
      "RootCaThumbprintPlaceholder": "__PLACEHOLDER_HOSPITAL_ROOT_CA_THUMBPRINT__"
    }
  },
  "AuditLogging": {
    "StorageProvider": "SqlServer",
    "ConnectionStringName": "AuditDatabaseConnection",
    "RetentionDays": 3650
  }
}
