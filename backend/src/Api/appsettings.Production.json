{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*.samchuk.hospital.local;app-ad.samchuk.moph.go.th",
  "Security": {
    "RequireHttps": true,
    "EnforceMfa": true
  },
  "ActiveDirectory": {
    "DomainControllerHost": "dc01.samchuk.hospital.local",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=Samchuk Hospital,DC=samchuk,DC=local",
    "IsLiveConnectionEnabled": false,
    "ConnectionTimeoutSeconds": 10
  },
  "AuditLogging": {
    "StorageProvider": "SqlServer",
    "ConnectionStringName": "AuditDatabaseConnection",
    "RetentionDays": 3650
  }
}
