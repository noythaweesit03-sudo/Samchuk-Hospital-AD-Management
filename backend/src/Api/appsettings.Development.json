{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": {
    "RequireHttps": false
  },
  "ActiveDirectory": {
    "DomainControllerHost": "mock-dc.samchuk.local",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=Samchuk Hospital,DC=samchuk,DC=local",
    "IsLiveConnectionEnabled": false
  },
  "AuditLogging": {
    "StorageProvider": "InMemory",
    "RetentionDays": 30
  }
}
