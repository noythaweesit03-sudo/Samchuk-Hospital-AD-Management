{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;testserver",
  "Security": {
    "RequireHttps": false
  },
  "ActiveDirectory": {
    "DomainControllerHost": "test-dc.samchuk.local",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=Test Hospital,DC=samchuk,DC=local",
    "IsLiveConnectionEnabled": false
  },
  "AuditLogging": {
    "StorageProvider": "InMemory",
    "RetentionDays": 7
  }
}
