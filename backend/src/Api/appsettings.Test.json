{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;testserver",
  "Security": {
    "RequireHttps": false
  },
  "ActiveDirectory": {
    "DomainControllerFqdn": "__PLACEHOLDER_TEST_DC_FQDN__",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=PLACEHOLDER_TEST_OU,DC=placeholder,DC=example",
    "ReadOnlyServiceAccount": "__PLACEHOLDER_READONLY_SERVICE_ACCOUNT__",
    "ReadOnlyServicePassword": "__PLACEHOLDER_SECRET_DO_NOT_LOG__",
    "ConnectionTimeoutSeconds": 10,
    "LdapPageSize": 100,
    "EnableLiveReadOnlyConnection": false,
    "CertificateValidation": {
      "RequireValidCertificateChain": true,
      "RequireHostnameMatch": true,
      "AllowWildcardCertificates": false,
      "RootCaThumbprintPlaceholder": "__PLACEHOLDER_HOSPITAL_ROOT_CA_THUMBPRINT__"
    }
  },
  "AuditLogging": {
    "StorageProvider": "InMemory",
    "RetentionDays": 7
  }
}
