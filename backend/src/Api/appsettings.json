{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": {
    "RequireHttps": true
  },
  "ActiveDirectory": {
    "DomainControllerHost": "__PLACEHOLDER_DOMAIN_CONTROLLER_HOST__",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=PLACEHOLDER_ORG_UNIT,DC=placeholder,DC=example",
    "IsLiveConnectionEnabled": false
  }
}
