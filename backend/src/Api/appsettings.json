{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;*.samchuk.hospital.local",
  "Security": {
    "RequireHttps": true
  },
  "ActiveDirectory": {
    "DomainControllerHost": "TBD_DOMAIN_CONTROLLER_HOST",
    "LdapsPort": 636,
    "UseSsl": true,
    "SearchBase": "OU=Samchuk Hospital,DC=samchuk,DC=local",
    "IsLiveConnectionEnabled": false
  }
}
