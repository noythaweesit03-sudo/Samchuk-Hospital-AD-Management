{
  "openapi": "3.0.1",
  "info": {
    "title": "Samchuk Hospital AD Management API Contract",
    "description": "OpenAPI Specification for Samchuk Hospital Active Directory Management Backend (Phase 1 & Phase 2 Read-Only Scope)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://ad-mgmt.samchuk.hospital.local/api",
      "description": "Application Server Production Reverse Proxy (TBD)"
    },
    {
      "url": "http://localhost:5000/api",
      "description": "Local ASP.NET Core Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check status",
        "responses": {
          "200": {
            "description": "Service is healthy and responding"
          }
        }
      }
    },
    "/diagnostics/connection-readiness": {
      "get": {
        "summary": "Retrieve Phase 2A offline LDAPS connection readiness diagnostics (Simulated / NotTested / NotConfigured)",
        "responses": {
          "200": {
            "description": "Connection readiness report with 6 diagnostic checks and redacted configuration"
          },
          "403": {
            "description": "Forbidden if caller lacks ADOperator, SecurityAuditor, or SystemAdministrator role"
          }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "summary": "Retrieve dashboard summary metrics and service statuses",
        "responses": {
          "200": {
            "description": "Dashboard summary object"
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Retrieve paginated and filtered list of AD users",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["All", "Enabled", "Disabled", "LockedOut"] } },
          { "name": "department", "in": "query", "schema": { "type": "string" } },
          { "name": "pageNumber", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Paged list of users"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get user details by opaque ID or sAMAccountName",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User details" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/computers": {
      "get": {
        "summary": "Retrieve paginated list of AD computers",
        "responses": { "200": { "description": "Paged list of computers" } }
      }
    },
    "/computers/{id}": {
      "get": {
        "summary": "Get computer details by ID or hostname",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Computer details" },
          "404": { "description": "Computer not found" }
        }
      }
    },
    "/ous/tree": {
      "get": {
        "summary": "Retrieve hierarchical OU tree",
        "responses": { "200": { "description": "Tree of organizational units" } }
      }
    },
    "/ous/{id}": {
      "get": {
        "summary": "Get OU details by ID or GUID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OU details" },
          "404": { "description": "OU not found" }
        }
      }
    },
    "/groups": {
      "get": {
        "summary": "Retrieve AD security and distribution groups",
        "responses": { "200": { "description": "List of groups" } }
      }
    },
    "/groups/{id}": {
      "get": {
        "summary": "Get group details by ID or sAMAccountName",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Group details" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/audit": {
      "get": {
        "summary": "Retrieve audit log entries (Admin/Auditor only)",
        "responses": {
          "200": { "description": "Paged list of audit entries" },
          "403": { "description": "Forbidden if caller lacks SecurityAuditor or SystemAdministrator role" }
        }
      }
    }
  }
}
