# Samchuk Hospital AD Management Environment Variables
# Architecture Option A: Independent AD Management (Isolated Application Server)
# WARNING: NEVER COMMIT REAL CREDENTIALS, HOSTNAMES, OR SERVICE ACCOUNT PASSWORDS.

# Application URL
APP_URL="http://localhost:3000"

# API Client Layer Mode: 'mock' (Phase 1 default) or 'http' (ASP.NET Core Web API integration)
VITE_API_CLIENT_MODE="mock"
VITE_AD_API_URL="/api"

# Active Directory & LDAPS Configuration (Phase 2 Safe Placeholders Only)
AD_DC_HOST="__PLACEHOLDER_DOMAIN_CONTROLLER_HOST__"
AD_LDAPS_PORT="636"
AD_SEARCH_BASE="OU=PLACEHOLDER_ORG_UNIT,DC=placeholder,DC=example"
AD_SERVICE_ACCOUNT="__PLACEHOLDER_READONLY_SERVICE_ACCOUNT__"
AD_SERVICE_PASSWORD="__PLACEHOLDER_SECURE_PASSWORD__"
AD_CA_CERT_PATH="/path/to/placeholder-root-ca.crt"
AD_LIVE_CONNECTION_ENABLED="false"
