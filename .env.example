# Samchuk Hospital AD Management Environment Variables
# Architecture Option A: Independent AD Management (Isolated Application Server)
# WARNING: NEVER COMMIT REAL CREDENTIALS, HOSTNAMES, OR SERVICE ACCOUNT PASSWORDS.

# Application URL
APP_URL="http://localhost:3000"

# API Client Layer Mode: 'mock' (Phase 1 default) or 'http' (ASP.NET Core Web API integration)
VITE_API_CLIENT_MODE="mock"
VITE_AD_API_URL="/api"

# Active Directory & LDAPS Configuration (Phase 2 TBD Placeholders)
AD_DC_HOST="TBD_DOMAIN_CONTROLLER_HOST"
AD_LDAPS_PORT="636"
AD_SEARCH_BASE="OU=Samchuk Hospital,DC=samchuk,DC=local"
AD_SERVICE_ACCOUNT="svc_ad_mgmt_ro"
AD_SERVICE_PASSWORD="TBD_SECURE_PASSWORD"
AD_CA_CERT_PATH="/etc/ssl/certs/samchuk-root-ca.crt"
AD_LIVE_CONNECTION_ENABLED="false"
